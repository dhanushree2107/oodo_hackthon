# DAYFLOW HRMS Environment Variables

PROJECT_NAME="DAYFLOW HRMS"
SECRET_KEY="super-secret-dayflow-jwt-key-change-in-production-2026"
REFRESH_SECRET_KEY="super-secret-dayflow-refresh-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL default for Prod/Docker, SQLite fallback for zero-config local dev)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/dayflow_db"
# DATABASE_URL="sqlite+aiosqlite:///./dayflow.db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Copilot (Optional - deterministic SQL tool calling engine used if key is omitted)
OPENAI_API_KEY=""

# Transactional Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@dayflow.io"
SMTP_PASSWORD="app-password"
EMAIL_FROM="noreply@dayflow.io"
