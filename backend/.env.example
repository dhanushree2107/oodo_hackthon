# Dayflow HRMS - Environment Configuration

# Application
PROJECT_NAME="DAYFLOW ENTERPRISE"
SECRET_KEY="dayflow_enterprise_super_secret_jwt_key_2026_hackathon"
DATABASE_URL="sqlite:///./dayflow.db"

# Transactional Email Provider Settings
# Options: resend, smtp
EMAIL_PROVIDER=resend

# Resend API Settings (Recommended)
# Get your free key from https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Details
# Note: For free Resend accounts, use onboarding@resend.dev until custom domain is verified
EMAIL_FROM="Dayflow HR <onboarding@resend.dev>"

# Optional SMTP Settings (used if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
